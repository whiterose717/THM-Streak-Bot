# THM Streak Bot - Environment Variables
# Copy this file to .env and fill in your values

# TryHackMe Credentials (for cookie export)
THM_EMAIL=your_email@example.com
THM_PASSWORD=your_password

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

# GitHub (for triggering workflows from Telegram)
GH_TOKEN=your_github_pat_with_workflow_scope

# Optional: Direct cookie database path (auto-detected if not set)
# THM_COOKIE_DB=/path/to/cookies.sqlite
